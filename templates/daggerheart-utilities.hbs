{{!-- The Daggerheart Utilities window. Untabbed, so this is a plain body wrapper —
     ApplicationV2 requires each part to render exactly one root element. The
     `name` on each input matches its key in SETTINGS, which is how ConfigWindow
     reads them back on save; `min` on the number field is what holds the saved
     value to at least one deck. --}}
<div class="ee-config-body">

  <fieldset>
    <legend>{{localize "EE.Utilities.ActionEffectsLegend"}}</legend>

    <div class="form-group">
      <label for="ee-relay-action-effects">{{localize "EE.Settings.RelayActionEffects.Name"}}</label>
      <div class="form-fields">
        <input type="checkbox" id="ee-relay-action-effects" name="relayActionEffects"
               {{#if relayActionEffects}}checked{{/if}}>
      </div>
      <p class="hint">{{localize "EE.Settings.RelayActionEffects.Hint"}}</p>
    </div>
  </fieldset>

  <fieldset>
    <legend>{{localize "EE.Utilities.DeckLimitLegend"}}</legend>

    <div class="form-group">
      <label for="ee-deck-limit-enabled">{{localize "EE.Settings.DeckLimitEnabled.Name"}}</label>
      <div class="form-fields">
        <input type="checkbox" id="ee-deck-limit-enabled" name="deckLimitEnabled"
               {{#if deckLimitEnabled}}checked{{/if}}>
      </div>
      <p class="hint">{{localize "EE.Settings.DeckLimitEnabled.Hint"}}</p>
    </div>

    <div class="form-group">
      <label for="ee-deck-limit-count">{{localize "EE.Settings.DeckLimitCount.Name"}}</label>
      <div class="form-fields">
        <input type="number" id="ee-deck-limit-count" name="deckLimitCount"
               min="1" step="1" value="{{deckLimitCount}}">
      </div>
      <p class="hint">{{localize "EE.Settings.DeckLimitCount.Hint"}}</p>
    </div>

    <div class="form-group">
      <label for="ee-deck-limit-players-only">{{localize "EE.Settings.DeckLimitPlayersOnly.Name"}}</label>
      <div class="form-fields">
        <input type="checkbox" id="ee-deck-limit-players-only" name="deckLimitPlayersOnly"
               {{#if deckLimitPlayersOnly}}checked{{/if}}>
      </div>
      <p class="hint">{{localize "EE.Settings.DeckLimitPlayersOnly.Hint"}}</p>
    </div>

    {{!-- Collapsed by default: these describe what a deck *is*, which most
         tables never need to change. A plain <details>, so the open/closed
         state costs no JS and no setting. --}}
    <details class="ee-deck-copies">
      <summary>{{localize "EE.Utilities.DeckContentsSummary"}}</summary>
      <div class="ee-deck-copies-body">
        <p class="hint">{{localize "EE.Utilities.DeckContentsHint"}}</p>

        {{#each deckCopies}}
        <div class="form-group">
          <label for="ee-{{key}}">{{localize label}}</label>
          <div class="form-fields">
            <input type="number" id="ee-{{key}}" name="{{key}}" min="0" step="1" value="{{value}}">
          </div>
        </div>
        {{/each}}
      </div>
    </details>
  </fieldset>

</div>
